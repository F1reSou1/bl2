# Bitrix24: CRM → Настройки → Интеграции → Входящий вебхук.
# Не добавляйте реальный URL в git и не размещайте его в HTML.
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/secret

# ID воронок сделок, созданных в CRM. Основная воронка обычно имеет ID 0.
BITRIX_CLIENT_CATEGORY_ID=2
BITRIX_RECRUITMENT_CATEGORY_ID=4

# Код пользовательского поля сделки для нормализованной рекомендации с сайта.
BITRIX_SITE_NOTE_FIELD=UF_CRM_1786668098223

# Полноценный чат сайта ↔ Открытая линия Bitrix24.
# Эти значения нужны только после создания локального приложения типа «Сервер».
# Не добавляйте секреты в репозиторий, HTML или клиентский JavaScript.
PUBLIC_SITE_URL=https://bl.tube-city.ru
BITRIX_OPENLINE_APP_CLIENT_ID=local.xxxxxxxx.xxxxxxxx
BITRIX_OPENLINE_APP_CLIENT_SECRET=replace-with-app-secret
BITRIX_OPENLINE_CALLBACK_TOKEN=generate-a-long-random-secret
BITRIX_OPENLINE_CONNECTOR_ID=blizkie_site_chat

# Хранилище токена приложения и активных переписок. В Dokploy укажите для
# папки /app/data постоянный volume, иначе после перезапуска потеряется связь
# между ответом менеджера и чатом посетителя.
CHAT_BRIDGE_STORE_PATH=/app/data/openline-chat.json
CHAT_MANAGER_TIMEZONE=Asia/Vladivostok
CHAT_MANAGER_START_HOUR=9
CHAT_MANAGER_END_HOUR=20
