# Bitrix24: CRM → Настройки → Интеграции → Входящий вебхук.
# Не добавляйте реальный URL в git и не размещайте его в HTML.
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/secret

# ID воронок сделок, созданных в CRM. Основная воронка обычно имеет ID 0.
BITRIX_CLIENT_CATEGORY_ID=2
BITRIX_RECRUITMENT_CATEGORY_ID=4
